@page "/Estudiante/edit/{EstudianteId:int}"
@inject EstudiantesService estudiantesService
@inject ToastService toastService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

@*HTML*@
<PageTitle>Modificar Estudiante</PageTitle>

<EditForm Model="estudiante" OnValidSubmit="@Modificar">
    <DataAnnotationsValidator />

    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header">
                <h5>Modificar Estudiante</h5>
            </div>

            <div class="card-body">
                @*EstudianteId*@
                <div class="mb-3">
                    <label class="form-label"><strong>EstudianteId</strong></label>
                    <InputNumber class="form-control" @bind-Value="estudiante.EstudianteId" readonly />
                </div>

                @*Nombres*@
                <div class="mb-3">
                    <label class="form-label"><strong>Nombres</strong></label>
                    <InputText class="form-control" @bind-Value="estudiante.Nombres" />
                    <ValidationMessage For="@(() => estudiante.Nombres)" />
                </div>

                @*Dirección*@
                <div class="mb-3">
                    <label class="form-label"><strong>Dirección</strong></label>
                    <InputText class="form-control" @bind-Value="estudiante.Direccion" />
                    <ValidationMessage For="@(() => estudiante.Direccion)" />
                </div>

                @*Email*@
                <div class="mb-3">
                    <label class="form-label"><strong>Email</strong></label>
                    <InputText class="form-control" @bind-Value="estudiante.Email" />
                    <ValidationMessage For="@(() => estudiante.Email)" />
                </div>

                @*Fecha de Nacimiento*@
                <div class="mb-3">
                    <label class="form-label"><strong>Fecha de Nacimiento</strong></label>
                    <InputDate class="form-control" @bind-Value="estudiante.FechaNacimiento" />
                    <ValidationMessage For="@(() => estudiante.FechaNacimiento)" />
                </div>
            </div>

            @*footer*@
            <div class="card-footer text-center">
                <a href="/Estudiantes/index" class="btn btn-secondary">
                    <span class="bi bi-arrow-left"></span> Volver
                </a>
                <button type="submit" class="btn btn-primary">
                    <span class="bi bi-floppy"></span> Modificar
                </button>
                <button type="button" class="btn btn-danger" @onclick="Eliminar">
                    <span class="bi bi-trash"></span> Eliminar
                </button>
            </div>
        </div>
    </div>
</EditForm>

@*Modal de confirmación*@
<div class="modal fade @(mostrarModal ? "show d-block" : "")" tabindex="-1" style="@(mostrarModal ? "background-color: rgba(0,0,0,0.5);" : "")">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar eliminación</h5>
                <button type="button" class="btn-close" @onclick="CerrarModal"></button>
            </div>
            <div class="modal-body">
                <p>¿Está seguro de eliminar este estudiante? Esta acción no se puede deshacer.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                <button type="button" class="btn btn-danger" @onclick="ConfirmarEliminar">Eliminar</button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int EstudianteId { get; set; }

    private Estudiantes estudiante { get; set; } = new Estudiantes();
    private bool mostrarModal = false;

    protected override async Task OnInitializedAsync()
    {
        var encontrado = await estudiantesService.Buscar(EstudianteId);
        if (encontrado != null)
        {
            estudiante = encontrado;
        }
        else
        {
            toastService.ShowError("Estudiante no encontrado");
            NavigationManager.NavigateTo("/Estudiantes/index");
        }
    }

    private async Task Modificar()
    {
        try
        {
            var actualizado = await estudiantesService.Guardar(estudiante);

            if (actualizado)
            {
                toastService.ShowSuccess("Estudiante modificado correctamente");
                NavigationManager.NavigateTo("/Estudiantes/index");
            }
            else
            {
                toastService.ShowError("No se pudo modificar el estudiante");
            }
        }
        catch (InvalidOperationException ex)
        {
            toastService.ShowError(ex.Message);
        }
    }

    private void Eliminar()
    {
        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
    }

    private async Task ConfirmarEliminar()
    {
        mostrarModal = false;

        var eliminado = await estudiantesService.Eliminar(estudiante.EstudianteId);

        if (eliminado)
        {
            toastService.ShowSuccess("Estudiante eliminado correctamente");
            NavigationManager.NavigateTo("/Estudiantes/index");
        }
        else
        {
            toastService.ShowError("No se pudo eliminar el estudiante");
        }
    }
}
