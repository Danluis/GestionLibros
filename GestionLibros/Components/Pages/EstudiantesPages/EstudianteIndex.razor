@page "/Estudiantes/Index"
@using Microsoft.AspNetCore.Components.QuickGrid
@inject EstudiantesService EstudiantesService
@rendermode InteractiveServer

<PageTitle>Consulta de Estudiantes</PageTitle>

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Consulta de Estudiantes</h5>
            <a href="/Estudiante/create" class="btn btn-primary">
                <span class="bi bi-plus-circle"></span> Nuevo Estudiante
            </a>
        </div>
        <div class="card-body">
            @*labels*@
            <div class="row mb-3">
                @*Filtrar por*@
                <div class="col-md-4">
                    <label class="form-label"><span class="bi bi-funnel"></span> Filtrar por</label>
                    <select class="form-select" @bind="criterioSeleccionado">
                        <option value="">Elija una opción</option>
                        <option value="estudianteId">Id</option>
                        <option value="nombres">Nombres</option>
                        <option value="email">Email</option>
                    </select>
                </div>
                @*Búsqueda*@
                <div class="col-md-6">
                    <label class="form-label">Búsqueda</label>
                    <div class="input-group">
                        <input type="text" class="form-control" placeholder="Buscar"
                               @bind="textoBusqueda" @bind:event="oninput"
                               @onkeyup="ManejarTecla" />
                        <button class="btn btn-outline-secondary" @onclick="Buscar">
                            <span class="bi bi-search"></span>
                        </button>
                    </div>
                </div>
            </div>

            @*tabla*@
            @if (estudiantes is null)
            {
                <p>Cargando...</p>
            }
            else
            {
                <QuickGrid Items="@estudiantes.AsQueryable()" Pagination="@paginacion" Class="table table-striped table-hover">
                    <PropertyColumn Property="@(e => e.EstudianteId)" Title="EstudianteId" Sortable="true" />
                    <PropertyColumn Property="@(e => e.Nombres)" Title="Nombres" Sortable="true" />
                    <PropertyColumn Property="@(e => e.Direccion)" Title="Dirección" Sortable="true" />
                    <PropertyColumn Property="@(e => e.Email)" Title="Email" Sortable="true" />
                    <PropertyColumn Property="@(e => e.FechaNacimiento)" Title="Fecha Nacimiento" Format="dd/MM/yyyy" Sortable="true" />
                    <TemplateColumn Title="Opciones">
                        <a href="@($"/Estudiante/edit/{context.EstudianteId}")" class="btn btn-sm btn-outline-primary">
                            <span class="bi bi-pencil-square"></span> Editar
                        </a>
                    </TemplateColumn>
                </QuickGrid>

                <Paginator State="@paginacion" />

                <p class="text-muted">Cantidad: @estudiantes.Count</p>
            }
        </div>
    </div>
</div>

@code {
    private List<Estudiantes>? estudiantes;
    private string criterioSeleccionado = "";
    private string textoBusqueda = "";
    private PaginationState paginacion = new PaginationState { ItemsPerPage = 5 };

    protected override async Task OnInitializedAsync()
    {
        estudiantes = await EstudiantesService.GetList(e => true);
    }

    private async Task ManejarTecla(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Buscar();
        }
    }

    private async Task Buscar()
    {
        if (string.IsNullOrWhiteSpace(textoBusqueda) || string.IsNullOrEmpty(criterioSeleccionado))
        {
            estudiantes = await EstudiantesService.GetList(e => true);
            return;
        }

        switch (criterioSeleccionado)
        {
            case "estudianteId":
                if (int.TryParse(textoBusqueda, out int idBuscado))
                {
                    estudiantes = await EstudiantesService.GetList(e => e.EstudianteId == idBuscado);
                }
                else
                {
                    estudiantes = new List<Estudiantes>();
                }
                break;

            case "nombres":
                estudiantes = await EstudiantesService.GetList(e => e.Nombres.Contains(textoBusqueda));
                break;

            case "email":
                estudiantes = await EstudiantesService.GetList(e => e.Email.Contains(textoBusqueda));
                break;

            default:
                estudiantes = await EstudiantesService.GetList(e => true);
                break;
        }
    }
}
