@page "/Estudiante/create"
@inject EstudiantesService estudiantesService
@inject ToastService toastService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

@*HTML*@
<PageTitle>Create</PageTitle>
<EditForm Model="estudiante" OnValidSubmit="@Guardar">
    <DataAnnotationsValidator />

    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header text-center">
                <h5>Crear Estudiante</h5>
            </div>

            <div class="card-body">
                @*Nombres*@
                <div class="mb-3">
                    <label class="form-label"><strong>Nombres</strong></label>
                    <InputText class="form-control" @bind-Value="estudiante.Nombres" />
                    <ValidationMessage For="@(() => estudiante.Nombres)" />
                </div>

                @*Dirección*@
                <div class="mb-3">
                    <label class="form-label"><strong>Dirección</strong></label>
                    <InputText class="form-control" @bind-Value="estudiante.Direccion" />
                    <ValidationMessage For="@(() => estudiante.Direccion)" />
                </div>

                @*Email*@
                <div class="mb-3">
                    <label class="form-label"><strong>Email</strong></label>
                    <InputText class="form-control" @bind-Value="estudiante.Email" />
                    <ValidationMessage For="@(() => estudiante.Email)" />
                </div>

                @*Fecha de Nacimiento*@
                <div class="mb-3">
                    <label class="form-label"><strong>Fecha de Nacimiento</strong></label>
                    <InputDate class="form-control" @bind-Value="estudiante.FechaNacimiento" />
                    <ValidationMessage For="@(() => estudiante.FechaNacimiento)" />
                </div>
            </div>

            @*footer*@
            <div class="card-footer text-center mt-2">
                <a href="/Estudiantes/index" class="btn btn-secondary"> <span class="bi bi-arrow-left"> Volver</span></a>
                <button type="submit" class="btn btn-primary bi bi-floppy"> Guardar</button>
            </div>
        </div>
    </div>

</EditForm>

@code {
    private Estudiantes estudiante { get; set; } = new Estudiantes
    {
        FechaNacimiento = DateTime.Now
    };

    private async Task Guardar()
    {
        try
        {
            var creado = await estudiantesService.Guardar(estudiante);

            if (creado)
            {
                toastService.ShowSuccess("El estudiante ha sido creado exitosamente.");
                NavigationManager.NavigateTo("/Estudiantes/index");
            }
            else
            {
                toastService.ShowError("No se pudo crear el estudiante.");
            }
        }
        catch (InvalidOperationException ex)
        {
            toastService.ShowError(ex.Message);
        }
    }
}
