@page "/Libros/Index"
@using Microsoft.AspNetCore.Components.QuickGrid
@inject LibrosService LibrosService
@rendermode InteractiveServer

<PageTitle>Consulta de Libros</PageTitle>

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Consulta de Libros</h5>
            <a href="/Libro/create" class="btn btn-primary">
                <span class="bi bi-plus-circle"></span> Nuevo Libro
            </a>
        </div>
        <div class="card-body">
            @*labels*@
            <div class="row mb-3">
                @*Filtrar por*@
                <div class="col-md-4">
                    <label class="form-label"><span class="bi bi-funnel"></span> Filtrar por</label>
                    <select class="form-select" @bind="criterioSeleccionado">
                        <option value="">Elija una opción</option>
                        <option value="libroId">Id</option>
                        <option value="titulo">Título</option>
                        <option value="autor">Autor</option>
                        <option value="anio">Año de Publicación</option>
                    </select>
                </div>
                @*Búsqueda*@
                <div class="col-md-6">
                    <label class="form-label">Búsqueda</label>
                    <div class="input-group">
                        <input type="text" class="form-control" placeholder="Buscar"
                               @bind="textoBusqueda" @bind:event="oninput"
                               @onkeyup="ManejarTecla" />
                        <button class="btn btn-outline-secondary" @onclick="Buscar">
                            <span class="bi bi-search"></span>
                        </button>
                    </div>
                </div>
            </div>

            @*tabla*@
            @if (libros is null)
            {
                <p>Cargando...</p>
            }
            else
            {
                <QuickGrid Items="@libros.AsQueryable()" Pagination="@paginacion" Class="table table-striped table-hover">
                    <PropertyColumn Property="@(l => l.LibroId)" Title="LibroId" Sortable="true" />
                    <PropertyColumn Property="@(l => l.Titulo)" Title="Título" Sortable="true" />
                    <PropertyColumn Property="@(l => l.Autor)" Title="Autor" Sortable="true" />
                    <PropertyColumn Property="@(l => l.AnoPublicacion)" Title="Año Publicación" Sortable="true" />
                    <TemplateColumn Title="">
                        <a href="@($"/Libro/edit/{context.LibroId}")" class="btn btn-sm btn-outline-primary">
                            <span class="bi bi-pencil-square"></span> Editar
                        </a>
                    </TemplateColumn>
                </QuickGrid>

                <Paginator State="@paginacion" />

                <p class="text-muted">Cantidad: @libros.Count</p>
            }
        </div>
    </div>
</div>

@code {
    private List<Libros>? libros;
    private string criterioSeleccionado = "";
    private string textoBusqueda = "";
    private PaginationState paginacion = new PaginationState { ItemsPerPage = 5 };

    protected override async Task OnInitializedAsync()
    {
        libros = await LibrosService.GetList(l => true);
    }

    private async Task ManejarTecla(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Buscar();
        }
    }

    private async Task Buscar()
    {
        if (string.IsNullOrWhiteSpace(textoBusqueda) || string.IsNullOrEmpty(criterioSeleccionado))
        {
            libros = await LibrosService.GetList(l => true);
            return;
        }

        switch (criterioSeleccionado)
        {
            case "libroId":
                if (int.TryParse(textoBusqueda, out int idBuscado))
                {
                    libros = await LibrosService.GetList(l => l.LibroId == idBuscado);
                }
                else
                {
                    libros = new List<Libros>();
                }
                break;

            case "titulo":
                libros = await LibrosService.GetList(l => l.Titulo.Contains(textoBusqueda));
                break;

            case "autor":
                libros = await LibrosService.GetList(l => l.Autor.Contains(textoBusqueda));
                break;

            case "anio":
                if (int.TryParse(textoBusqueda, out int anioBuscado))
                {
                    libros = await LibrosService.GetList(l => l.AnoPublicacion == anioBuscado);
                }
                else
                {
                    libros = new List<Libros>();
                }
                break;

            default:
                libros = await LibrosService.GetList(l => true);
                break;
        }
    }
}
