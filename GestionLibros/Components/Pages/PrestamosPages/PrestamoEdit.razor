@page "/Prestamo/edit/{PrestamoId:int}"
@inject PrestamosService prestamosService
@inject DevolucionesService devolucionesService
@inject ToastService toastService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

@*HTML*@
<PageTitle>Modificar Préstamo</PageTitle>

<EditForm Model="prestamo" OnValidSubmit="@Modificar">
    <DataAnnotationsValidator />

    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header">
                <h5>Modificar Préstamo</h5>
            </div>

            <div class="card-body">
                @*Estudiante*@
                <div class="mb-3">
                    <label class="form-label"><strong>Estudiante</strong></label>
                    <input class="form-control" value="@prestamo.Estudiante?.Nombres" readonly />
                </div>

                @*Libro*@
                <div class="mb-3">
                    <label class="form-label"><strong>Libro</strong></label>
                    <input class="form-control" value="@prestamo.Libro?.Titulo" readonly />
                </div>

                @*Fecha de Préstamo*@
                <div class="mb-3">
                    <label class="form-label"><strong>Fecha de Préstamo</strong></label>
                    <input class="form-control" value="@prestamo.FechaPrestamo.ToShortDateString()" readonly />
                </div>

                @*Activo*@
                <div class="mb-3 form-check">
                    <InputCheckbox class="form-check-input" @bind-Value="prestamo.Activo" id="checkActivo" />
                    <label class="form-check-label" for="checkActivo"><strong>Préstamo activo (sin devolver)</strong></label>
                </div>
            </div>

            @*footer*@
            <div class="card-footer text-center">
                <a href="/Prestamos/index" class="btn btn-secondary">
                    <span class="bi bi-arrow-left"></span> Volver
                </a>
                <button type="submit" class="btn btn-primary">
                    <span class="bi bi-floppy"></span> Modificar
                </button>
                @if (prestamo.Activo)
                {
                    <button type="button" class="btn btn-warning" @onclick="Devolver">
                        <span class="bi bi-box-arrow-in-left"></span> Marcar como devuelto
                    </button>
                }
                <button type="button" class="btn btn-danger" @onclick="Eliminar">
                    <span class="bi bi-trash"></span> Eliminar
                </button>
            </div>
        </div>
    </div>
</EditForm>

@*Modal de confirmación*@
<div class="modal fade @(mostrarModal ? "show d-block" : "")" tabindex="-1" style="@(mostrarModal ? "background-color: rgba(0,0,0,0.5);" : "")">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar eliminación</h5>
                <button type="button" class="btn-close" @onclick="CerrarModal"></button>
            </div>
            <div class="modal-body">
                <p>¿Está seguro de eliminar este préstamo? Esta acción no se puede deshacer.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                <button type="button" class="btn btn-danger" @onclick="ConfirmarEliminar">Eliminar</button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int PrestamoId { get; set; }

    private Prestamos prestamo { get; set; } = new Prestamos();
    private bool mostrarModal = false;

    protected override async Task OnInitializedAsync()
    {
        var resultado = await prestamosService.Buscar(PrestamoId);
        if (resultado.IsSuccess && resultado.Value is not null)
        {
            prestamo = resultado.Value;
        }
        else
        {
            toastService.ShowError("Préstamo no encontrado");
            NavigationManager.NavigateTo("/Prestamos/index");
        }
    }

    private async Task Modificar()
    {
        var resultado = await prestamosService.Guardar(prestamo);

        resultado.OnSuccess(() =>
        {
            toastService.ShowSuccess("Préstamo modificado correctamente");
            NavigationManager.NavigateTo("/Prestamos/index");
        });

        resultado.OnFailure(() =>
        {
            toastService.ShowError(resultado.Error.Description);
        });
    }

    private async Task Devolver()
    {
        var devolucion = new Devolucion { PrestamoId = prestamo.PrestamoId };
        var resultado = await devolucionesService.Guardar(devolucion);

        resultado.OnSuccess(() =>
        {
            toastService.ShowSuccess("Libro devuelto correctamente");
            NavigationManager.NavigateTo("/Prestamos/index");
        });

        resultado.OnFailure(() =>
        {
            toastService.ShowError(resultado.Error.Description);
        });
    }

    private void Eliminar()
    {
        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
    }

    private async Task ConfirmarEliminar()
    {
        mostrarModal = false;

        var resultado = await prestamosService.Eliminar(prestamo.PrestamoId);

        resultado.OnSuccess(() =>
        {
            toastService.ShowSuccess("Préstamo eliminado correctamente");
            NavigationManager.NavigateTo("/Prestamos/index");
        });

        resultado.OnFailure(() =>
        {
            toastService.ShowError(resultado.Error.Description);
        });
    }
}
